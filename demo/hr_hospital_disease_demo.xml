<odoo>
    <record id="hr_hospital_disease_demo_respiratory" model="hr.hospital.disease">
        <field name="name">Респіраторні захворювання</field>
        <field name="description">Захворювання дихальної системи.</field>
    </record>

    <record id="hr_hospital_disease_demo_pneumonia" model="hr.hospital.disease">
        <field name="name">Пневмонія</field>
        <field name="parent_id" ref="hr_hospital_disease_demo_respiratory" />
        <field name="description">Запалення легень.</field>
    </record>

    <record id="hr_hospital_disease_demo_bronchitis" model="hr.hospital.disease">
        <field name="name">Бронхіт</field>
        <field name="parent_id" ref="hr_hospital_disease_demo_respiratory" />
        <field name="description">Запалення бронхів.</field>
    </record>

    <record id="hr_hospital_disease_demo_endocrine" model="hr.hospital.disease">
        <field name="name">Ендокринні захворювання</field>
        <field name="description">Захворювання ендокринної системи.</field>
    </record>

    <record id="hr_hospital_disease_demo_thyroiditis" model="hr.hospital.disease">
        <field name="name">Тиреоїдит</field>
        <field name="parent_id" ref="hr_hospital_disease_demo_endocrine" />
        <field name="description">Запалення щитоподібної залози.</field>
    </record>
</odoo>
