<odoo>
    <record id="hr_hospital_doctor_report_pdf" model="ir.actions.report">
        <field name="name">Doctor Report (PDF)</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_hospital.report_doctor</field>
        <field name="report_file">hr_hospital.report_doctor</field>
        <field name="print_report_name">'Doctor - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor" />
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro" />
    </record>

    <template id="report_doctor">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="company" t-value="res_company" />
                <div class="header">
                    <div class="d-flex justify-content-between align-items-center border-bottom pb-2">
                        <img
                            t-if="company.logo"
                            t-att-src="image_data_uri(company.logo)"
                            style="max-height: 45px;"
                            alt="Logo"
                        />
                        <div class="text-end">
                            <strong t-field="company.name" />
                            <div
                                t-field="company.partner_id"
                                t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": true}'
                            />
                        </div>
                    </div>
                </div>
                <div
                    class="article"
                    t-att-data-oe-model="doc._name"
                    t-att-data-oe-id="doc.id"
                >
                    <div class="page">
                        <h2>
                            <span t-field="doc.name" />
                            <t t-if="doc.specialty">
                                — <span t-field="doc.specialty" />
                            </t>
                        </h2>
                        <h4>Visit History</h4>
                        <p t-if="not doc.visit_ids">No visits found.</p>
                        <table t-if="doc.visit_ids" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Scheduled</th>
                                    <th>Patient</th>
                                    <th>Disease</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.visit_ids" t-as="visit">
                                    <td><span t-field="visit.scheduled_date" /></td>
                                    <td><span t-field="visit.patient_id" /></td>
                                    <td><span t-field="visit.disease_id" /></td>
                                    <td t-att-style="'background-color: %s;' % {'planned': '#fff3cd', 'done': '#d1e7dd', 'cancelled': '#f8d7da'}[visit.state]">
                                        <span t-field="visit.state" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <h4>Patients</h4>
                        <p t-if="not doc.patient_ids">No patients found.</p>
                        <table t-if="doc.patient_ids" class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Full Name</th>
                                    <th>Gender</th>
                                    <th>Date of Birth</th>
                                    <th>Phone</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.patient_ids" t-as="patient">
                                    <td><span t-field="patient.name" /></td>
                                    <td><span t-field="patient.gender" /></td>
                                    <td><span t-field="patient.birthdate" /></td>
                                    <td><span t-field="patient.phone" /></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="footer">
                    <div class="d-flex justify-content-between border-top pt-2">
                        <span t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')" />
                        <span t-field="company.city" />
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
