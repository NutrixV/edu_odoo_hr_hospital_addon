<odoo>
    <record id="hr_hospital_visit_report_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.report.form</field>
        <field name="model">hr.hospital.visit.report</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="doctor_ids" widget="many2many_tags" />
                        <field name="patient_ids" widget="many2many_tags" />
                        <field name="disease_id" />
                    </group>
                    <group>
                        <field name="date_from" />
                        <field name="date_to" />
                        <field name="only_done" />
                    </group>
                </group>
                <footer>
                    <button name="action_show_visits" type="object" string="Show Visits" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_hospital_visit_report_action_patient" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr.hospital.visit.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient" />
        <field name="binding_view_types">list,form</field>
    </record>

    <record id="hr_hospital_visit_report_action_doctor" model="ir.actions.act_window">
        <field name="name">Visit Report</field>
        <field name="res_model">hr.hospital.visit.report</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_doctor" />
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
