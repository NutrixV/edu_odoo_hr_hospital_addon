<odoo>
    <record id="hr_hospital_patient_reassign_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.reassign.doctor.form</field>
        <field name="model">hr.hospital.patient.reassign.doctor</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="doctor_id" />
                    <field name="change_date" />
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary" />
                    <button string="Cancel" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_reassign_doctor_action" model="ir.actions.act_window">
        <field name="name">Reassign Personal Doctor</field>
        <field name="res_model">hr.hospital.patient.reassign.doctor</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_hr_hospital_patient" />
        <field name="binding_view_types">list</field>
    </record>
</odoo>
