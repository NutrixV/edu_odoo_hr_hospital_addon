<odoo>
    <record id="hr_hospital_patient_list" model="ir.ui.view">
        <field name="name">hr.hospital.patient.list</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="birthdate" />
                <field name="age" />
                <field name="gender" />
                <field name="phone" />
                <field name="doctor_id" />
            </list>
        </field>
    </record>

    <record id="hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_create_quick_visit"
                        type="object"
                        string="New Visit"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            class="oe_stat_button"
                            name="action_view_visits"
                            type="object"
                            icon="fa-calendar"
                        >
                            <field name="visit_count" widget="statinfo" string="Visits" />
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="birthdate" />
                            <field name="age" />
                            <field name="gender" />
                            <field name="blood_group" />
                            <field name="rh_factor" />
                        </group>
                        <group>
                            <field name="phone" widget="phone" />
                            <field name="doctor_id" />
                            <field name="insurance_number" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Doctor History" name="doctor_history">
                            <field name="history_ids">
                                <list>
                                    <field name="doctor_id" />
                                    <field name="assign_date" />
                                    <field name="change_date" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_patient_search" model="ir.ui.view">
        <field name="name">hr.hospital.patient.search</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <search>
                <field
                    name="name"
                    string="Patient"
                    filter_domain="['|', ('name', 'ilike', self), ('phone', 'ilike', self)]"
                />
                <field name="phone" />
                <field name="doctor_id" />
            </search>
        </field>
    </record>

    <record id="hr_hospital_patient_action" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="hr_hospital_patient_search" />
    </record>

</odoo>
