<odoo>
    <record id="hr_hospital_doctor_category_list" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.category.list</field>
        <field name="model">hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" />
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="hr_hospital_doctor_category_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.category.form</field>
        <field name="model">hr.hospital.doctor.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="sequence" />
                    </group>
                    <field name="doctor_ids" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_doctor_category_action" model="ir.actions.act_window">
        <field name="name">Doctor Categories</field>
        <field name="res_model">hr.hospital.doctor.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
