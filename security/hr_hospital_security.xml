<odoo noupdate="1">
    <record id="hr_hospital_visit_rule_patient" model="ir.rule">
        <field name="name">Hospital Visit: patient reads own visits</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="groups" eval="[Command.link(ref('group_hospital_patient'))]"/>
        <field name="domain_force">[('patient_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_visit_rule_intern" model="ir.rule">
        <field name="name">Hospital Visit: intern manages own visits</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="groups" eval="[Command.link(ref('group_hospital_intern'))]"/>
        <field name="domain_force">[('doctor_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_visit_rule_doctor" model="ir.rule">
        <field name="name">Hospital Visit: doctor manages own and interns visits</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="groups" eval="[Command.link(ref('group_hospital_doctor'))]"/>
        <field name="domain_force">['|', ('doctor_id.user_id', '=', user.id), ('doctor_id.mentor_id.user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_visit_rule_manager" model="ir.rule">
        <field name="name">Hospital Visit: manager sees all visits</field>
        <field name="model_id" ref="model_hr_hospital_visit"/>
        <field name="groups" eval="[Command.link(ref('group_hospital_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

    <record id="hr_hospital_patient_rule_patient" model="ir.rule">
        <field name="name">Hospital Patient: patient reads own record</field>
        <field name="model_id" ref="model_hr_hospital_patient"/>
        <field name="groups" eval="[Command.link(ref('group_hospital_patient'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="hr_hospital_patient_rule_intern" model="ir.rule">
        <field name="name">Hospital Patient: medical staff sees all patients</field>
        <field name="model_id" ref="model_hr_hospital_patient"/>
        <field name="groups" eval="[Command.link(ref('group_hospital_intern'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
